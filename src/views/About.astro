---
import Base from '../layouts/Base.astro';
import { t, href, formatDate, type Lang } from '../i18n';
import { works } from '../works';
import { site } from '../site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const s = t(lang);
const when = (w: string) => (w === 'now' ? s.now : w === 'before' ? s.before : w);
---
<Base lang={lang} path="/about" title={s.about}>
  <div class="page about">
    <header class="page-head">
      <h1>{s.about}</h1>
    </header>

    <div class="grid">
      <div class="photos">
        <figure class="p1"><img src="/images/beste-door.webp" alt={s.photoAlt1} width="1320" height="1160" /></figure>
        <figure class="p2"><img src="/images/beste-sea.webp" alt={s.photoAlt2} width="1012" height="1400" loading="lazy" /></figure>
        <span class="ink-art map" aria-hidden="true" style="-webkit-mask-image:url(/images/bosphorus-ink.webp);mask-image:url(/images/bosphorus-ink.webp)"></span>
      </div>

      <div class="cv">
        <div class="bio">
          {site.bio[lang].map((p) => <p>{p}</p>)}
        </div>

        <section>
          <h2 class="mono">{s.publications}</h2>
          <ul>
            {works.map((w) => (
              <li>
                <span class="when mono">{w.date.slice(0, 4)}</span>
                <span><a href={href(lang, `/works/${w.slug}`)} lang="en">“{w.title}”</a>, <i>{w.venue}</i>{w.issue ? ` ${w.issue}` : ''}</span>
              </li>
            ))}
            {site.alsoIn.map((p) => (
              <li>
                <span class="when mono">{p.note.en.match(/\d{4}/)?.[0] ?? '·'}</span>
                <span><i>{p.venue}</i>, {p.note[lang]}</span>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="mono">{s.education}</h2>
          <ul>
            {site.education.map((e) => (
              <li><span class="when mono">{e.when}</span><span>{e[lang].place}, {e[lang].what}</span></li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="mono">{s.honors}</h2>
          <ul>
            {site.honors.map((h) => (
              <li><span class="when mono">{h.when}</span><span>{h[lang]}</span></li>
            ))}
          </ul>
        </section>

        <section>
          <h2 class="mono">{s.roles}</h2>
          <ul>
            {site.roles.map((r) => (
              <li><span class="when mono">{when(r.when)}</span><span>{r[lang]}</span></li>
            ))}
          </ul>
        </section>

        {site.email && (
          <section>
            <h2 class="mono">{s.contact}</h2>
            <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
          </section>
        )}

        <button class="print mono" type="button" onclick="window.print()">{s.print}</button>

        <p class="credits mono">
          {s.imageCredits}: budgerigar, 1869 lithograph · sunflower from Basilius Besler, <i>Hortus Eystettensis</i> (1713 ed.) · nautilus etching, Rijksmuseum · map of the Bosphorus, 1839. public domain, via Wikimedia Commons.
        </p>
      </div>
    </div>
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 64px;
    align-items: start;
  }
  .photos { position: relative; min-height: 640px; }
  figure { margin: 0; }
  figure img { width: 100%; height: auto; box-shadow: var(--shadow); }
  .p1 { width: 82%; transform: rotate(-2deg); position: relative; z-index: 2; }
  .p1 img { border: 10px solid #fbf8f1; }
  .p2 { width: 52%; position: absolute; right: 0; top: 300px; transform: rotate(4deg); z-index: 3; }
  .p2 img { border: 8px solid #fbf8f1; border-bottom-width: 36px; }
  .map { position: absolute; left: -6%; top: 260px; width: 60%; aspect-ratio: 0.74; z-index: 1; opacity: 0.22; }

  .bio p { margin: 0 0 1em; font-size: 1.3125rem; line-height: 1.5; }
  .bio p:first-child { font-size: 1.75rem; line-height: 1.3; font-style: italic; color: var(--wood); }
  section { margin-top: 36px; }
  h2 { margin: 0 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--rule); font-weight: 400; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: grid; grid-template-columns: 84px 1fr; gap: 12px; padding: 5px 0; font-size: 1.0625rem; line-height: 1.4; }
  .when { padding-top: 0.2em; }
  .print {
    margin-top: 40px;
    background: none; border: 1px solid var(--ink); color: var(--ink);
    padding: 10px 16px; border-radius: 999px; cursor: pointer;
  }
  .print:hover { background: var(--ink); color: var(--paper); }
  .credits { margin-top: 40px; font-size: 0.6875rem; line-height: 1.6; text-transform: none; letter-spacing: 0.02em; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; gap: 32px; }
    .photos { min-height: 0; padding-bottom: 60%; }
    .p2 { top: auto; bottom: 0; }
  }

  /* the about page doubles as a one-page CV */
  @media print {
    :global(body::before), :global(.dock), :global(.top .controls), :global(.skip), .photos, .print, .credits { display: none !important; }
    :global(body) { background: #fff; color: #000; font-size: 11pt; }
    .grid { display: block; }
    .page-head { padding: 0 0 8px; margin-bottom: 16px; }
    .page-head h1 { font-size: 22pt; }
    .page-head h1::after { content: ' · beste yılmaz'; }
    section { margin-top: 14px; break-inside: avoid; }
    .bio p { font-size: 11pt; }
    .bio p:first-child { font-size: 12pt; color: inherit; }
    a { text-decoration: none; }
  }
</style>
