---
import '../styles/global.css';
import Dock from '../components/Dock.astro';
import { t, href, type Lang } from '../i18n';
import { site } from '../site';

interface Props {
  lang: Lang;
  path: string; // language-neutral path, e.g. "/works/speak"
  title?: string;
  description?: string;
}
const { lang, path, title, description } = Astro.props;
const s = t(lang);
const other: Lang = lang === 'en' ? 'tr' : 'en';
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${s.tagline}`;
const desc = description ?? site.bio[lang][0];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL('/images/beste-sea.webp', site.url).href} />
    <link rel="alternate" hreflang="en" href={new URL(href('en', path), site.url).href} />
    <link rel="alternate" hreflang="tr" href={new URL(href('tr', path), site.url).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f3eee4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#253d2f" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Courier+Prime&family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="top">
      <a class="name" href={href(lang, '/')}>{site.name}</a>
      <div class="controls">
        <a class="mono lang" href={href(other, path)} hreflang={other} lang={other} aria-label={s.langSwitchLabel}>
          <span aria-hidden="true" class:list={{ on: lang === 'en' }}>en</span>
          <span aria-hidden="true">/</span>
          <span aria-hidden="true" class:list={{ on: lang === 'tr' }}>tr</span>
        </a>
        <button class="theme" type="button" aria-label={s.themeLabel}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M12 3.5a8.5 8.5 0 0 1 0 17z" fill="currentColor"></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <Dock lang={lang} path={path} />

    <script is:inline>
      document.querySelector('.theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .top {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: min(100% - 32px, 1120px);
    margin-inline: auto;
    padding: 22px 0;
  }
  .name {
    font-family: var(--mono);
    font-size: 0.875rem;
    letter-spacing: 0.22em;
    text-decoration: none;
  }
  .controls { display: flex; align-items: center; gap: 14px; }
  .lang { text-decoration: none; display: inline-flex; gap: 6px; padding: 6px 4px; }
  .lang .on { color: var(--ink); text-decoration: underline; text-underline-offset: 0.3em; }
  .theme {
    display: grid; place-items: center;
    width: 36px; height: 36px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: transform 0.4s ease;
  }
  .theme:hover { transform: rotate(180deg); color: var(--leaf); }
</style>
